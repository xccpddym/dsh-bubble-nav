{
  "name": "dsh-bubble-nav",
  "description": "Bubble navigation for dsh: a draggable accelerator ball listing all of your questions (numbered + timed), plus a full outline panel with category filters. Hover/click to jump anywhere in the conversation.",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-bubble-nav": "bin/install.js"
  },
  "files": [
    "lib",
    "bin",
    "install.ps1",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xccpddym/dsh-bubble-nav.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "license": "MIT"
}
